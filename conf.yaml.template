server:
  port: 1983
  mode: "debug" # or "release"
  log_max_size_mb: 32 # log file rollover size in MB
  log_max_backups: 5  # number of old log files to keep
  log_max_age_days: 30 # days to retain old log files

postgres:
  host: "localhost"
  port: 5432
  user: "mobius"
  password: "mobius"
  dbname: "mobius"

elasticsearch:
  url: "http://localhost:9200"
  events:
    buffer_size: 5000
    batch_size: 50
    flush_interval_s: 5
    retention_days: 90
    archive_cron: "0 3 * * *"

chat_upload:
  max_file_size_mb: 20

# Sandbox for host-executing commands (run_command tool + bash adapter).
# Commands run inside an ephemeral container whose only writable mount is the
# project dir (or an ephemeral temp dir for project-less tasks), so a runaway
# command cannot damage the host. Build the image once: `make build-sandbox`.
# Set enabled: false to run commands directly on the host instead (no isolation).
sandbox:
  enabled: true
  provider: "nsjail"           # "nsjail" | "docker" | "none"
  nsjail_path: "./bin/nsjail"  # resolved via LookPath if relative/unset
  image: "mobius-agent:latest" # built by `make build-sandbox` (docker fallback)
  network: "bridge"            # "bridge" to allow pip/go mod/cargo/git fetch (docker fallback)
  memory_mb: 0                 # 0 = no rlimit_as cap (nsjail default); >0 = best-effort
  cpus: "2"                    # docker fallback
  pids_limit: 512              # docker fallback

google_cloud:
  project_id: "your-gcp-project-id"
  credentials_path: "" # leave empty to use ADC
  api_key: ""           # optional: AI Studio API key for Gemini models (overrides service account for Gemini)
  bigquery:
    project_id: ""  # leave empty to use top-level project_id
    dataset: "mobius"          # system-internal data ONLY (events, token usage)
    event_table: "events"
    token_table: "token_usage"
    # Media tagging (video_tagging.md §4.1). Business data lives in a DEDICATED
    # dataset, never `dataset` above. All optional — these are the code defaults.
    creatives_dataset: "mobius_creatives"      # dedicated business dataset for tags
    connection: "us.mobius_conn"               # BQ cloud-resource connection (see `make bq-connection`)
    tagging_model_endpoint: "gemini-3.6-flash" # multimodal model
    tagging_model_name: "tagging_gemini"       # remote model name created in creatives_dataset
  gcs:
    project_id: ""  # leave empty to use top-level project_id
    bucket: "mobius"
    location: "us-central1"
    public_access_prevention: true
    event_archive_prefix: "events/archived"
  vertex_ai:
    project_id: ""  # leave empty to use top-level project_id
    models:
      - id: "gemini-3.6-flash"
        name: "Gemini 3.6 Flash"
        model_id: "gemini-3.6-flash"
        location: "global"
        type: "llm"
        default: true
      - id: "gemini-3.1-flash-image"
        name: "Gemini 3.1 Flash Image"
        model_id: "gemini-3.1-flash-image"
        location: "global"
        type: "image"
        default: true
      - id: "veo-3.1"
        name: "Veo 3.1"
        model_id: "veo-3.1-generate-001"
        location: "global"
        type: "video"
        default: true
      - id: "gemini-omni-flash"
        name: "Gemini Omni Flash"
        model_id: "gemini-omni-flash-preview"
        location: "global"
        type: "video"
