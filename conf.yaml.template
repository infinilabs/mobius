server:
  port: 1983
  mode: "debug" # or "release"
  log_max_size_mb: 32 # log file rollover size in MB
  log_max_backups: 5  # number of old log files to keep
  log_max_age_days: 30 # days to retain old log files

postgres:
  host: "localhost"
  port: 5432
  user: "mobius"
  password: "mobius"
  dbname: "mobius"

elasticsearch:
  url: "http://localhost:9200"

google_cloud:
  project_id: "your-gcp-project-id"
  credentials_path: "" # leave empty to use ADC
  bigquery:
    dataset: "mobius"
  vertex_ai:
    llm_model_id: "gemini-3.1-pro-preview"
    llm_location: "global"
    img_model_id: ""
    img_location: "us-central1"
    video_model_id: ""
    video_location: "us-central1"
