server:
  port: 1983
  mode: "debug" # or "release"
  log_max_size_mb: 32 # log file rollover size in MB
  log_max_backups: 5  # number of old log files to keep
  log_max_age_days: 30 # days to retain old log files

postgres:
  host: "localhost"
  port: 5432
  user: "mobius"
  password: "mobius"
  dbname: "mobius"

elasticsearch:
  url: "http://localhost:9200"

google_cloud:
  project_id: "your-gcp-project-id"
  credentials_path: "" # leave empty to use ADC
  bigquery:
    dataset: "mobius"
  gcs:
    bucket: "mobius"
    location: "us-central1"
    public_access_prevention: true
  vertex_ai:
    models:
      - id: "gemini-3.1-pro"
        name: "Gemini 3.1 Pro"
        model_id: "gemini-3.1-pro-preview"
        location: "global"
        type: "llm"
        default: true
      - id: "gemini-3.1-flash-image"
        name: "Gemini 3.1 Flash Image"
        model_id: "gemini-3.1-flash-image-preview"
        location: "global"
        type: "image"
        default: true
      - id: "veo-3.1"
        name: "Veo 3.1"
        model_id: "veo-3.1-generate-001"
        location: "global"
        type: "video"
        default: true
