server:
  port: 1983
  mode: "debug" # or "release"
  log_max_size_mb: 32 # log file rollover size in MB
  log_max_backups: 5  # number of old log files to keep
  log_max_age_days: 30 # days to retain old log files

postgres:
  host: "localhost"
  port: 5432
  user: "mobius"
  password: "mobius"
  dbname: "mobius"

elasticsearch:
  url: "http://localhost:9200"
  events:
    buffer_size: 5000
    batch_size: 50
    flush_interval_s: 5
    retention_days: 90
    archive_cron: "0 3 * * *"

chat_upload:
  max_file_size_mb: 20

# Sandbox for host-executing commands (run_command tool + bash adapter).
# Commands run inside an ephemeral container whose only writable mount is the
# project dir (or an ephemeral temp dir for project-less tasks), so a runaway
# command cannot damage the host. Build the image once: `make build-sandbox`.
# Set enabled: false to run commands directly on the host instead (no isolation).
sandbox:
  enabled: true
  image: "mobius-agent:latest" # built by `make build-sandbox` (see sandbox/Dockerfile)
  network: "bridge"            # "bridge" to allow pip/go mod/cargo/git fetch; "none" for full offline
  memory_mb: 2048
  cpus: "2"
  pids_limit: 512

google_cloud:
  project_id: "your-gcp-project-id"
  credentials_path: "" # leave empty to use ADC
  api_key: ""           # optional: AI Studio API key for Gemini models (overrides service account for Gemini)
  bigquery:
    project_id: ""  # leave empty to use top-level project_id
    dataset: "mobius"
    event_table: "events"
    token_table: "token_usage"
  gcs:
    project_id: ""  # leave empty to use top-level project_id
    bucket: "mobius"
    location: "us-central1"
    public_access_prevention: true
    event_archive_prefix: "events/archived"
  vertex_ai:
    project_id: ""  # leave empty to use top-level project_id
    models:
      - id: "gemini-3.1-pro"
        name: "Gemini 3.1 Pro"
        model_id: "gemini-3.1-pro-preview"
        location: "global"
        type: "llm"
        default: true
      - id: "gemini-3.1-flash-image"
        name: "Gemini 3.1 Flash Image"
        model_id: "gemini-3.1-flash-image-preview"
        location: "global"
        type: "image"
        default: true
      - id: "veo-3.1"
        name: "Veo 3.1"
        model_id: "veo-3.1-generate-001"
        location: "global"
        type: "video"
        default: true
