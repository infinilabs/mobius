{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "id":          { "type": "keyword" },
      "title":       { "type": "text", "fields": { "raw": { "type": "keyword" } } },
      "body":        { "type": "text" },
      "status":      { "type": "keyword" },
      "priority":    { "type": "keyword" },
      "assignee_id": { "type": "keyword" },
      "creator_id":  { "type": "keyword" },
      "project_id":  { "type": "keyword" },
      "created_at":  { "type": "date" },
      "updated_at":  { "type": "date" }
    }
  }
}
